# Django Secret Key
SECRET_KEY="django-insecure-rose-flowers-secret-key-change-in-production"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Cloud Database (Hỗ trợ cả TiDB Cloud Serverless hoặc Neon/Supabase PostgreSQL)
# 1. Ví dụ TiDB Cloud (MySQL Protocol):
# DATABASE_URL="mysql://username.root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/rose_flowers?ssl-mode=VERIFY_IDENTITY"
# 2. Ví dụ Neon.tech (PostgreSQL Protocol):
# DATABASE_URL="postgresql://username:password@ep-cool-flower-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# Cloud Storage cho Hình ảnh hoa (Cloudinary.com - Miễn phí 25GB)
# Lấy từ Cloudinary Dashboard: Settings -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend Origin cho CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
